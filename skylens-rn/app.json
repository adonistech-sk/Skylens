{
  "expo": {
    "name": "SkyLens",
    "slug": "skylens",
    "scheme": "skylens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#060A14",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "sk.skylens.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "sk.skylens.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/newsreader/300Light/Newsreader_300Light.ttf",
            "./node_modules/@expo-google-fonts/newsreader/300Light_Italic/Newsreader_300Light_Italic.ttf",
            "./node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
            "./node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
            "./node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf"
          ]
        }
      ],
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#060A14",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sharing",
      "expo-asset",
      "expo-localization",
      "expo-web-browser",
      "expo-iap",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SkyLens uses your location to calculate which stars and planets are above you. It stays on your device."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "AR Sky shows the sky overlay on your live camera view. Nothing is recorded unless you press the shutter.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "SkyLens uses the motion sensors to match the star map to where you point your iPhone."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "SkyLens saves your AR Sky photos to your library when you press the shutter.",
          "savePhotosPermission": "SkyLens saves your AR Sky photos to your library when you press the shutter."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
